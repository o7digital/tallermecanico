---
import{site}from"@/data/site";import Icon from"./Icon.astro";
---
<section class="section services" id="servicios"><div class="container"><div class="section-head reveal"><div><p class="eyebrow">Lo que hacemos</p><h2>Servicio completo.<br/>Soluciones reales.</h2></div><p>Revisamos, explicamos y proponemos únicamente el trabajo que tu vehículo necesita.</p></div><div class="service-grid">{site.services.map((s,i)=><article class="service-card reveal"><span class="number">{String(i+1).padStart(2,"0")}</span><div class="service-icon"><Icon name={s.icon} size={23}/></div><h3>{s.title}</h3><p>{s.desc}</p><button data-service={s.title}>Cotizar servicio <Icon name="arrow" size={15}/></button></article>)}</div></div></section>
